{
  "name": "vardot/drupal-core-patches",
  "description": "Curated Drupal core patches used by Varbase, one branch per Drupal core major.minor version.",
  "keywords": [
    "composer",
    "patches",
    "composer patches",
    "varbase",
    "drupal",
    "drupal core",
    "drupal core patches"
  ],
  "license": "GPL-2.0-or-later",
  "type": "metapackage",
  "authors": [
    {
      "name": "Vardot",
      "homepage": "https://www.drupal.org/vardot",
      "role": "Maintainer"
    }
  ],
  "require": {
    "drupal/core": "~12.0.0",
    "cweagans/composer-patches": "~1.7.0 || ~2.0"
  },
  "extra": {
    "branch-alias": {
      "dev-12.0.x": "12.0.x-dev"
    },
    "enable-patching": true,
    "patches": {
      "drupal/core": {}
    }
  }
}
