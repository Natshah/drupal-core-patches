{
  "name": "vardot/drupal-core-patches",
  "description": "Drupal core patch files used by Varbase (file store). The per-core-minor branches reference these files by raw URL.",
  "keywords": [
    "composer",
    "patches",
    "composer patches",
    "varbase",
    "drupal",
    "drupal core",
    "drupal core patches"
  ],
  "license": "GPL-2.0-or-later",
  "type": "metapackage",
  "authors": [
    {
      "name": "Vardot",
      "homepage": "https://www.drupal.org/vardot",
      "role": "Maintainer"
    }
  ],
  "require": {
    "cweagans/composer-patches": "~1.7.0 || ~2.0"
  },
  "extra": {
    "branch-alias": {
      "dev-patches": "dev-patches"
    }
  }
}
